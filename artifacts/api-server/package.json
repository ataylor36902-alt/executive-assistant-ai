{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:edu-instructor-history": "trap 'rm -f .edu-instructor-history-test.cjs' EXIT; esbuild test/edu-instructor-history.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --outfile=.edu-instructor-history-test.cjs && node --test .edu-instructor-history-test.cjs",
    "test:edu-course-cleanup": "trap 'rm -f .edu-course-cleanup-test.cjs' EXIT; esbuild test/edu-course-file-cleanup.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=../../lib/db/src/index.ts --outfile=.edu-course-cleanup-test.cjs && NODE_ENV=production node --test .edu-course-cleanup-test.cjs",
    "test:library-syllabus": "trap 'rm -f .library-syllabus-test.cjs' EXIT; esbuild test/library-syllabus.test.mjs --bundle --platform=node --format=cjs --external:sharp --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.library-syllabus-test.cjs && node --test .library-syllabus-test.cjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "privacy:retention": "pnpm run build && node --enable-source-maps ./dist/privacy-retention.mjs",
    "test:privacy": "trap 'rm -f .privacy-test.mjs' EXIT; node test/build-privacy-test.mjs && node --test .privacy-test.mjs",
    "test:privacy-minor": "trap 'rm -f .privacy-minor-test.cjs' EXIT; esbuild test/privacy-minor.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=./test/fixtures/privacy-minor-db.mjs --outfile=.privacy-minor-test.cjs && node --test .privacy-minor-test.cjs",
    "test:access": "trap 'rm -f .course-access-test.cjs' EXIT; esbuild test/course-access.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=../../lib/db/src/index.ts --outfile=.course-access-test.cjs && node --test .course-access-test.cjs",
    "test:edu": "trap 'rm -f .edu-test.cjs' EXIT; esbuild test/classscribe-edu.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --alias:@workspace/integrations-openai-ai-server=./test/fixtures/modern-transcription-ai.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.edu-test.cjs && node --test .edu-test.cjs",
    "test:edu-learning": "trap 'rm -f .edu-learning-test.cjs' EXIT; esbuild test/classscribe-edu-learning.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --outfile=.edu-learning-test.cjs && node --test .edu-learning-test.cjs",
    "test:edu-media": "trap 'rm -f .edu-media-test.cjs' EXIT; node test/build-edu-media-test.mjs && node --test .edu-media-test.cjs",
    "test:edu-submission-files": "trap 'rm -f .edu-submission-test.cjs' EXIT; node test/build-edu-submission-test.mjs && node --test .edu-submission-test.cjs",
    "test:privacy-logging": "trap 'rm -f .privacy-logging-test.cjs' EXIT; node test/build-privacy-logging-test.mjs && NODE_ENV=production node --test .privacy-logging-test.cjs",
    "test:syllabus": "trap 'rm -f .syllabus-test.cjs' EXIT; esbuild test/syllabus-proposals.test.mjs --bundle --platform=node --format=cjs --outfile=.syllabus-test.cjs && node --test .syllabus-test.cjs",
    "test:coursework": "trap 'rm -f .coursework-test.cjs' EXIT; esbuild test/syllabus-coursework.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --alias:@workspace/integrations-openai-ai-server=./test/fixtures/study-guide-ai.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.coursework-test.cjs && node --test .coursework-test.cjs",
    "test:grades": "trap 'rm -f .grades-test.cjs' EXIT; esbuild test/grades.test.mjs --bundle --platform=node --format=cjs --outfile=.grades-test.cjs && node --test .grades-test.cjs",
    "test:student-grades": "trap 'rm -f .student-grades-test.cjs' EXIT; esbuild test/student-grades.test.mjs --bundle --platform=node --format=cjs --external:sharp --alias:@workspace/db=../../lib/db/src/index.ts --alias:@replit/connectors-sdk=./test/fixtures/elevenlabs-connector.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.student-grades-test.cjs && node --test .student-grades-test.cjs",
    "test:help-navigation": "trap 'rm -f .help-navigation-test.cjs' EXIT; esbuild test/help-navigation.test.mjs --bundle --platform=node --format=cjs --outfile=.help-navigation-test.cjs && node --test .help-navigation-test.cjs",
