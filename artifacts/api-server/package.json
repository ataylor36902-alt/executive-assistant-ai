    "test:legacy": "trap 'rm -f .legacy-test.cjs' EXIT; esbuild test/classscribe-legacy.test.mjs --bundle --platform=node --format=cjs --external:sharp --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --alias:@replit/connectors-sdk=./test/fixtures/elevenlabs-connector.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.legacy-test.cjs && if [ -n \"$LEGACY_TEST_PATTERN\" ]; then node --test --test-name-pattern=\"$LEGACY_TEST_PATTERN\" .legacy-test.cjs; else node --test .legacy-test.cjs; fi",
    "test:study-injection:provider": "trap 'rm -f .study-injection-test.cjs' EXIT; esbuild test/classscribe-legacy.test.mjs --bundle --platform=node --format=cjs --external:sharp --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --alias:@replit/connectors-sdk=./test/fixtures/elevenlabs-connector.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.study-injection-test.cjs && RUN_STUDY_INJECTION_PROVIDER_TESTS=1 node --test --test-name-pattern='study injection' .study-injection-test.cjs",
    "test:materials-extract": "trap 'rm -f .materials-extract-test.cjs' EXIT; esbuild test/materials-extract.test.mjs --bundle --platform=node --format=cjs --external:pdf-parse --alias:@workspace/db=../../lib/db/src/index.ts --alias:@replit/connectors-sdk=./test/fixtures/elevenlabs-connector.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.materials-extract-test.cjs && node --test .materials-extract-test.cjs",
    "test:edu-inquiries": "trap 'rm -f .edu-inquiries-test.mjs' EXIT; esbuild test/classscribe-edu-inquiries.test.mjs --bundle --platform=node --format=esm --packages=external --alias:@workspace/db=./test/fixtures/edu-inquiry-db.mjs --alias:@replit/connectors-sdk=./test/fixtures/elevenlabs-connector.mjs --outfile=.edu-inquiries-test.mjs && node --test .edu-inquiries-test.mjs",
    "test:stripe-webhook": "trap 'rm -f .stripe-webhook-test.mjs' EXIT; node test/build-stripe-webhook-test.mjs && REPLIT_DOMAINS=webhook.test node --test .stripe-webhook-test.mjs",
