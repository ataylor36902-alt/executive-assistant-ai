    "test:credits-periods": "trap 'rm -f .credits-periods-test.cjs' EXIT; esbuild test/credits-subscription-periods.test.mjs --bundle --platform=node --format=cjs --outfile=.credits-periods-test.cjs && node --test .credits-periods-test.cjs",
    "test:library-link": "trap 'rm -f .library-link-test.cjs' EXIT; esbuild test/library-link.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --alias:@replit/connectors-sdk=./test/fixtures/elevenlabs-connector.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.library-link-test.cjs && node --test .library-link-test.cjs",
    "test:modern-billing": "trap 'rm -f .modern-billing-test.cjs' EXIT; esbuild test/classscribe-billing.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --alias:@workspace/integrations-openai-ai-server=./test/fixtures/modern-transcription-ai.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.modern-billing-test.cjs && node --test .modern-billing-test.cjs",
    "test:privacy-consents": "trap 'rm -f .privacy-consents-test.cjs' EXIT; esbuild test/classscribe-consents.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=./test/fixtures/privacy-consent-db.mjs --outfile=.privacy-consents-test.cjs && node --test .privacy-consents-test.cjs",
    "test:study-guides": "trap 'rm -f .study-guides-test.cjs' EXIT; esbuild test/study-guides.test.mjs --bundle --platform=node --format=cjs --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --alias:@workspace/integrations-openai-ai-server=./test/fixtures/study-guide-ai.mjs --alias:@replit/connectors-sdk=./test/fixtures/elevenlabs-connector.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.study-guides-test.cjs && node --test .study-guides-test.cjs",
    "test:credits-overage-ask": "trap 'rm -f .credits-overage-ask-test.cjs' EXIT; esbuild test/credits-overage-ask.test.mjs --bundle --platform=node --format=cjs --external:sharp --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --alias:@workspace/integrations-openai-ai-server/audio=./test/fixtures/ask-test-ai.mjs --alias:@workspace/integrations-openai-ai-server=./test/fixtures/ask-test-ai.mjs --alias:@replit/connectors-sdk=./test/fixtures/elevenlabs-connector.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.credits-overage-ask-test.cjs && node --test .credits-overage-ask-test.cjs",
    "test:ask-semantic": "trap 'rm -f .ask-semantic-test.cjs' EXIT; esbuild test/ask-semantic.test.mjs --bundle --platform=node --format=cjs --external:sharp --alias:@workspace/db=../../lib/db/src/index.ts --alias:@clerk/express=./test/fixtures/clerk-test-auth.mjs --alias:@replit/connectors-sdk=./test/fixtures/elevenlabs-connector.mjs --alias:stripe-replit-sync=./test/fixtures/stripe-replit-sync.mjs --outfile=.ask-semantic-test.cjs && node --test .ask-semantic-test.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
